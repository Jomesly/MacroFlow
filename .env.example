# ── MacroFlow environment template ──────────────────────────────────
# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Market data providers ──
FINNHUB_API_KEY=
AV_API_KEY=
FRED_API_KEY=

# Independent market-context switches (public/build-time; rebuild after changing).
# Official BLS/BEA/ONS schedules and direct U.S. Treasury yields; no keys required.
# Hosted access must still pass the release checks. DXY/VIX are excluded.
NEXT_PUBLIC_MARKET_CALENDAR_ENABLED=true
NEXT_PUBLIC_MARKET_MACRO_ENABLED=true

# Apply supabase/journal-screenshots.sql and validate private bucket access first.
NEXT_PUBLIC_JOURNAL_SCREENSHOTS_ENABLED=false

# ── RSS feed URLs ──
RSS_MARKETWATCH=
RSS_FXSTREET=
RSS_COINDESK=
RSS_INVESTING_GOLD=

# ── Upstash Redis (cache + history) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase (server-side; service role never leaves the server) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase client-side auth (inlined into the browser bundle) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth links and rollout (must match Supabase Site/Redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Enable only after signup-login.sql, Confirm Email and email templates are ready.
AUTH_SIGNUP_ENABLED=false

# Optional Cloudflare Turnstile public site key. Rebuild after setting it.
# Configure its matching SECRET only in Supabase Auth > Bot and Abuse Protection.
# Deploy the widget before enabling Supabase CAPTCHA. Leave blank for local tests.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Cron protection (Phase 3) ──
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# GitHub Actions fallback sends: x-cron-secret: <CRON_SECRET>
CRON_SECRET=

# ── Legacy / currently unused (kept for reference) ──
# FMP_API_KEY=            # FMP calendar deprecated; src/lib/api/fmp.ts is dead code
# TWELVE_DATA_API_KEY=    # market data currently uses Yahoo + Alpha Vantage
# REFRESH_INTERVAL=       # client poll interval is hardcoded (page.tsx)
# SUPABASE_PUBLISHABLE_KEY=
